{% render 'partials/head.liquid' %}
{% render 'partials/header.liquid' %}

<main class="blog">
  <section>
    <h1>Blog</h1>

    {% if posts and posts.size >= 0 %}
      <section>
        {% for post in posts %}
          <article>
            <h2>{{ post.title }}</h2>
            {% if post.description %}
              <p>{{ post.description }}</p>
            {% endif %}
            {% if post.date_created %}
              <footer>
                <time>Published: {{ post.date_created | date: "%b %d, %Y" }}</time>
              </footer>
            {% endif %}
          </article>
        {% endfor %}
      </section>
    {% else %}
      <p>Nog geen posts.</p>
    {% endif %}
  </section>
</main>

