{% for project in projects %}
  <div class="project-card">
    {% if project.image_url %}
      <img src="{{ project.image_url }}" alt="{{ project.title }}" style="width:200px;">
    {% endif %}
    
    <h2>{{ project.title }}</h2>
    <p>{{ project.description }}</p>
    
    {% if project.link %}
      <a href="{{ project.link }}">View Project</a>
    {% endif %}
  </div>
{% endfor %}