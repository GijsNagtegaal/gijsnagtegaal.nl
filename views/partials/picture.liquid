{% if imagesrc contains '/assets/images' %}

    <picture class="{{ class }}">
        <source srcset="{{ imagesrc }}.avif?width={{ width }}&height={{ height }}&quality=70" type="image/avif">
        <source srcset="{{ imagesrc }}.webp?width={{ width }}&height={{ height }}&quality=70" type="image/webp">
        <img class="{{ class }}" src="{{ imagesrc }}?width={{ width }}&height={{ height }}&quality=60" fetchpriority="{{ fetch }}" loading="{{ loading }}" style="{{ style }}" alt="">
    </picture>

{% else %}

    <picture class="{{ class }}">
        <source srcset="{{ imagesrc }}?width={{ width }}&height={{ height }}&format=avif&quality=70" type="image/avif">
        <source srcset="{{ imagesrc }}?width={{ width }}&height={{ height }}&format=webp&quality=70" type="image/webp">
        <img class="{{ class }}" src="{{ imagesrc }}?width={{ width }}&height={{ height }}&quality=60" fetchpriority="{{ fetch }}" loading="{{ loading }}" style="{{ style }}" alt="">
    </picture>

{% endif %}