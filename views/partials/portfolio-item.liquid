<article class="portfolio-item {{ customclass }}">
    <a class="card" href="/portfolio/project/{{ project.slug }}">
        {% if project.image %}
            {% render 'partials/picture.liquid',
                imagesrc: project.image,
                width: "350",
                height: "200",
                alt: project.Opdrachtgever,
                class: "landscape",
                loading: "lazy"
            %}
        {% endif %}
    
        <!-- tags array -->
        <header class="tags">
            {% for tag in project.tags %}
                <span class="tag">{{ tag }}</span>
            {% endfor %}
        </header>

        <div class="contentwrapper">
            <h3>{{ project.type_site }} voor {{ project.Opdrachtgever }}</h3>
            <p class="opdracht">{{ project.opdracht }}</p>
        </div>
    </a>
    <a class="project" href="/portfolio/project/{{ project.slug }}">
        Bekijk het volledige project
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" >
            <path d="M5 12H19M12 19L19 12L12 5" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </a>
</article>