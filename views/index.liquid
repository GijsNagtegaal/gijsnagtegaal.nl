        {% for tech in techStack limit: 6 %}
            {% capture tech_classes %}round badge techstack pos-{{ forloop.index }}{% endcapture %}
            {% render 'partials/picture.liquid',
                imagesrc: tech.image,
                imagesrc_dark: tech.image_dark,
                width: "80",
                height: "80",
                alt: tech.name,
                class: tech_classes,
                fetch: "high",
            %}
        {% endfor %}

    </section>

    <!-- About me + portfolio button-->
    <section class="about">
        <h2> I am a <em> frontend </em> <em> developer </em> </h2>
        <p>In addition to studying Frontend Design & Development at the HvA, I work as a freelance developer helping small business owners create their first professional website or online store.</p>
        {% render 'partials/link.liquid',
            content: "Check my portfolio",
            custom_class: "primary",
            svg: "true",
        %}
    </section>

    <!-- section with my tech stack -->
    <section class="techstack"> 
        <h3>My Current <em> tech stack </em></h3>
        <section>
            {% for tech in techStack %}
                <figure>
                    {% render 'partials/picture.liquid',
                        imagesrc: tech.image,
                        imagesrc_dark: tech.image_dark,
                        width: "100",
                        height: "100",
                        class: tech_classes,
                        fetch: "high",
                    %}
                    <figcaption>{{ tech.name }}</figcaption>
                </figure>
            {% endfor %}
        </section>
    </section>

    <!-- most recent work -->
    <section class="recentwork">
        <h3> Recent <em> projects </em> </h3>
        <section class="workwrapper">
            {% for project in projects %}
                {% render 'partials/portfolio-item.liquid', project: project, customclass: "scroll-animated", %}
            {% else %}
                <p>No projects found.</p>
            {% endfor %}
        </section>
    </section>


</main>