{% render 'partials/head.liquid' %}
{% render 'partials/header.liquid', currentPath: currentPath %}
<main>
    <section>
        <h1>{{ project.type_site }} voor {{ project.Opdrachtgever }}</h1>
        <p>{{ project.opdracht }}</p>

        <header class="tag-container">
            {% for tag in project.tags %}
                <span class="tag">{{ tag }}</span>
            {% endfor %}
        </header>
        
        {% if project.image %}
            {% render 'partials/picture.liquid',
                imagesrc: project.image,
                width: "800",
                height: "450",
                class: "landscape",
                loading: "eager"
            %}
        {% endif %}

        <p class="description">
            {{ project.description }}
        </p>

        <a href="/portfolio">Terug naar overzicht</a>
    </section>
</main>